# Import from the existing /etc/caddy/Caddyfile; preserve existing sites.
leopnt.net {
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
    handle /_leopnt/github {
        request_body {
            max_size 2MB
        }
        reverse_proxy 127.0.0.1:9880
    }
    handle /_next/static/* {
        root * /opt/leopnt/assets
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:3200
    }
}

www.leopnt.net, leopnt.cn, www.leopnt.cn {
    redir https://leopnt.net{uri} permanent
}

